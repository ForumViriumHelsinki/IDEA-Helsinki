# IDEA Helsinki Environment Variables Example
#
# This file shows how to fetch secrets from Google Secret Manager for local development.
#
# Setup:
#   1. Copy this file: cp .env.example .env
#   2. Run with dotenvx: dotenvx run -- skaffold dev
#   3. Or source directly: source .env && skaffold dev
#
# Note: Requires gcloud CLI authenticated with fvh-project-containers-etc

# InfluxDB Configuration
export INFLUX_DB_URL="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-influxdb-url)"
export INFLUX_DB_ORG="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-influxdb-org)"
export INFLUX_DB_FCD_TOKEN="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-influx-fcd-token)"
export INFLUX_DB_VALIDATION_TOKEN="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-influx-validation-token)"
export INFLUX_DB_FCD_BUCKET="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-influx-fcd-bucket)"
export INFLUX_DB_VALIDATION_BUCKET="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-influx-validation-bucket)"

# Azure Configuration (for fcd-manager service)
export AZURE_ACCOUNT_NAME="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-azure-account-name)"
export AZURE_SAS_TOKEN="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-azure-sas-token)"
export AZURE_CONTAINER_NAME="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=idea-helsinki-azure-container-name)"

# Sentry Configuration (optional)
export SENTRY_DSN="$(gcloud secrets versions access latest --project=fvh-project-containers-etc --secret=sentry_dsn_idea-helsinki)"
