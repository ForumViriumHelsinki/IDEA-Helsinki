apiVersion: v1
kind: Secret
metadata:
  name: idea-helsinki-secrets
  namespace: idea-helsinki
type: Opaque
stringData:
  # Azure configuration
  AZURE_ACCOUNT_NAME: "${AZURE_ACCOUNT_NAME}"
  AZURE_CONTAINER_NAME: "${AZURE_CONTAINER_NAME}"
  AZURE_SAS_TOKEN: "${AZURE_SAS_TOKEN}"

  # InfluxDB configuration
  INFLUX_DB_ORG: "${INFLUX_DB_ORG}"
  INFLUX_DB_URL: "${INFLUX_DB_URL}"
  INFLUX_DB_FCD_BUCKET: "${INFLUX_DB_FCD_BUCKET}"
  INFLUX_DB_FCD_TOKEN: "${INFLUX_DB_FCD_TOKEN}"
  INFLUX_DB_VALIDATION_BUCKET: "${INFLUX_DB_VALIDATION_BUCKET}"
  INFLUX_DB_VALIDATION_TOKEN: "${INFLUX_DB_VALIDATION_TOKEN}"

  # Sentry configuration (optional)
  SENTRY_DSN: "${SENTRY_DSN}"
