{
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingImports": false,
  "reportPrivateImportUsage": false,
  "exclude": [
    "shared/src/idea_shared/lib/idea/profile/util.py",
    "shared/src/idea_shared/lib/idea/validation/util.py",
    "shared/src/idea_shared/lib/TomTomFcdAggregator.py",
    "shared/src/idea_shared/classes/IdeaHelsinkiRoadSegment.py",
    "shared/src/idea_shared/classes/IntersectionDetector.py",
    "shared/src/idea_shared/classes/AzureBlobContainerManager.py",
    "shared/src/idea_shared/classes/HelsinkiWFSClient.py",
    "shared/src/idea_shared/feature_flags/examples.py",
    "shared/src/idea_shared/feature_flags/providers/goff_provider.py",
    "shared/src/idea_shared/health/example_usage.py"
  ],
  "executionEnvironments": [
    {
      "root": "services/orchestrator",
      "extraPaths": ["services/orchestrator/src"]
    },
    {
      "root": "services/fcd-manager",
      "extraPaths": ["services/fcd-manager/src"]
    },
    {
      "root": "services/traffic-monitor",
      "extraPaths": ["services/traffic-monitor/src"]
    }
  ]
}
